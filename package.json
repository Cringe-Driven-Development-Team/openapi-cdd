{
  "name": "openapi-playground",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "apidog": "bun scripts/apidog.ts",
    "generate": "bun scripts/generate.ts spec/openapi.json -o src/api/schema.d.ts",
    "sync": "bun run apidog && bun run generate",
    "demo": "bun src/demo.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.schema.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
